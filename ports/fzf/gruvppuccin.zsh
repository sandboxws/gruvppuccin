# Gruvppuccin color scheme for fzf
# Source this file in your .zshrc/.bashrc:
#   source /path/to/gruvppuccin.zsh

export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }\
--color=fg:#d4be98,bg:#181a1b,hl:#d8a657 \
--color=fg+:#d4be98,bg+:#2e2c2b,hl+:#e78a4e \
--color=border:#413c39,header:#7daea3,gutter:#181a1b \
--color=spinner:#e78a4e,info:#7daea3 \
--color=pointer:#c28fd6,marker:#d4879c,prompt:#a9b665"
