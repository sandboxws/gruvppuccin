# ────────────────────────────────────────────────────────────
#  GENERATED FILE — DO NOT EDIT
#  source: palette.json + templates/newsboat/colors.tmpl
#  regen:  python3 scripts/generate.py
# ────────────────────────────────────────────────────────────
# Gruvppuccin Latte — Gruvbox × Catppuccin blend
#
# newsboat has no hex support, so every color is quantized to its nearest
# xterm-256 index (cube + gray ramp, indices 16-255; 0-15 are excluded because
# terminals remap them).
#
#   text     #3c3836 → color237   base     #f2e5bc → color223
#   surface1 #d5c4a1 → color187   overlay0 #a89984 → color138
#   green    #8a8f1a → color100   yellow   #c88c22 → color172
#   sapphire #1a7f8c → color30    red      #d93e32 → color167
#   peach    #e06f1e → color166   mauve    #a44d85 → color132
#   pink     #c04e58 → color131   teal     #47855e → color65

color background          color237  color223
color listnormal          color237  color223
color listnormal_unread   color100  color223  bold
color listfocus           color237  color187  bold
color listfocus_unread    color100  color187  bold
color info                color223  color30
color article             color237  color223
color title               color237  color30  bold
color hint-key            color223  color30  bold
color hint-keys-delimiter color223  color30
color hint-separator      color223  color30
color hint-description    color223  color30
color end-of-text-marker  color138  color223

highlight article "^(Feed|Link):.*$"         color172 color223 bold
highlight article "^(Title|Date|Author):.*$" color172 color223 bold
highlight article "https?://[^ ]+"           color30 color223 underline
highlight article "\\[[0-9]+\\]"             color100 color223 bold
highlight article "\\[image [0-9]+.*\\]"     color166 color223 bold
highlight feedlist "[║│]"                     color132 color223 bold
