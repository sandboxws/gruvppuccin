# ────────────────────────────────────────────────────────────
#  GENERATED FILE — DO NOT EDIT
#  source: palette.json + templates/newsboat/colors.tmpl
#  regen:  python3 scripts/generate.py
# ────────────────────────────────────────────────────────────
# Gruvbark Haze — Gruvbox × Catppuccin blend
#
# newsboat has no hex support, so every color is quantized to its nearest
# xterm-256 index (cube + gray ramp, indices 16-255; 0-15 are excluded because
# terminals remap them).
#
#   text     #33303a → color236   base     #f5f1e2 → color255
#   surface1 #e7e0d2 → color253   overlay0 #a69fa1 → color247
#   green    #a8a828 → color142   yellow   #e2aa30 → color179
#   sapphire #4f979a → color66    red      #d93e32 → color167
#   peach    #e06f1e → color166   mauve    #c47098 → color168
#   pink     #d06062 → color167   teal     #739e6c → color71

color background          color236  color255
color listnormal          color236  color255
color listnormal_unread   color142  color255  bold
color listfocus           color236  color253  bold
color listfocus_unread    color142  color253  bold
color info                color255  color66
color article             color236  color255
color title               color236  color66  bold
color hint-key            color255  color66  bold
color hint-keys-delimiter color255  color66
color hint-separator      color255  color66
color hint-description    color255  color66
color end-of-text-marker  color247  color255

highlight article "^(Feed|Link):.*$"         color179 color255 bold
highlight article "^(Title|Date|Author):.*$" color179 color255 bold
highlight article "https?://[^ ]+"           color66 color255 underline
highlight article "\\[[0-9]+\\]"             color142 color255 bold
highlight article "\\[image [0-9]+.*\\]"     color166 color255 bold
highlight feedlist "[║│]"                     color168 color255 bold
