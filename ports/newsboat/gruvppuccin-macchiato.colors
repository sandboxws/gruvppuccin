# ────────────────────────────────────────────────────────────
#  GENERATED FILE — DO NOT EDIT
#  source: palette.json + templates/newsboat/colors.tmpl
#  regen:  python3 scripts/generate.py
# ────────────────────────────────────────────────────────────
# Gruvppuccin Macchiato — Gruvbox × Catppuccin blend
#
# newsboat has no hex support, so every color is quantized to its nearest
# xterm-256 index (cube + gray ramp, indices 16-255; 0-15 are excluded because
# terminals remap them).
#
#   text     #d4be98 → color180   base     #181a1b → color234
#   surface1 #2e2c2b → color236   overlay0 #5a524c → color239
#   green    #a9b665 → color143   yellow   #d8a657 → color179
#   sapphire #7daea3 → color109   red      #ea6962 → color167
#   peach    #e78a4e → color173   mauve    #c28fd6 → color140
#   pink     #d68299 → color174   teal     #8fb18a → color108

color background          color180  color234
color listnormal          color180  color234
color listnormal_unread   color143  color234  bold
color listfocus           color180  color236  bold
color listfocus_unread    color143  color236  bold
color info                color234  color109
color article             color180  color234
color title               color180  color109  bold
color hint-key            color234  color109  bold
color hint-keys-delimiter color234  color109
color hint-separator      color234  color109
color hint-description    color234  color109
color end-of-text-marker  color239  color234

highlight article "^(Feed|Link):.*$"         color179 color234 bold
highlight article "^(Title|Date|Author):.*$" color179 color234 bold
highlight article "https?://[^ ]+"           color109 color234 underline
highlight article "\\[[0-9]+\\]"             color143 color234 bold
highlight article "\\[image [0-9]+.*\\]"     color173 color234 bold
highlight feedlist "[║│]"                     color140 color234 bold
