{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "crust": "#0b0d10",
    "mantle": "#0f1218",
    "base": "#12151a",
    "surface0": "#171b22",
    "surface1": "#232830",
    "surface2": "#2d333d",
    "overlay0": "#3a414d",
    "overlay1": "#4b5462",
    "overlay2": "#5c6470",
    "subtext0": "#8a93a0",
    "subtext1": "#b6bcc6",
    "text": "#e6e8ec",
    "rosewater": "#f3dedc",
    "flamingo": "#f5c2c2",
    "pink": "#f472b6",
    "mauve": "#a78bfa",
    "red": "#fb7185",
    "maroon": "#fda4af",
    "peach": "#38bdf8",
    "yellow": "#f5b454",
    "green": "#5eead4",
    "teal": "#34d399",
    "sky": "#7dd3fc",
    "sapphire": "#7c6cf6",
    "blue": "#7c6cf6",
    "lavender": "#c4b5fd"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:subtext0",
          "style": "plain",
          "template": "{{.Icon}} ",
          "type": "os"
        },
        {
          "foreground": "p:sapphire",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "p:yellow",
          "options": {
            "folder_icon": "....",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:peach{{ end }}",
            "{{ if gt .Ahead 0 }}p:sky{{ end }}",
            "{{ if gt .Behind 0 }}p:flamingo{{ end }}"
          ],
          "options": {
            "branch_icon": " ",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": false,
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          },
          "template": "{{ .HEAD }} ",
          "style": "plain",
          "type": "git"
        },
        {
          "style": "plain",
          "foreground": "p:overlay2",
          "template": "",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
