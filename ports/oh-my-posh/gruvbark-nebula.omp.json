{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "crust": "#171722",
    "mantle": "#1c1b26",
    "base": "#282630",
    "surface0": "#36313f",
    "surface1": "#403a46",
    "surface2": "#524a57",
    "overlay0": "#6a616c",
    "overlay1": "#8e8689",
    "overlay2": "#999191",
    "subtext0": "#a49b98",
    "subtext1": "#d0d4c4",
    "text": "#dbdfcd",
    "rosewater": "#fc9822",
    "flamingo": "#fd6e22",
    "pink": "#e87163",
    "mauve": "#d3869b",
    "red": "#fb4934",
    "maroon": "#fc5c2b",
    "peach": "#fe8019",
    "yellow": "#fabd2f",
    "green": "#b8bb26",
    "teal": "#98ae6a",
    "sky": "#9db6a8",
    "sapphire": "#83a598",
    "blue": "#83a598",
    "lavender": "#bb8f9a"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:subtext0",
          "style": "plain",
          "template": "{{.Icon}} ",
          "type": "os"
        },
        {
          "foreground": "p:sapphire",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "p:yellow",
          "options": {
            "folder_icon": "....",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:peach{{ end }}",
            "{{ if gt .Ahead 0 }}p:sky{{ end }}",
            "{{ if gt .Behind 0 }}p:flamingo{{ end }}"
          ],
          "options": {
            "branch_icon": " ",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": false,
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          },
          "template": "{{ .HEAD }} ",
          "style": "plain",
          "type": "git"
        },
        {
          "style": "plain",
          "foreground": "p:overlay2",
          "template": "",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
