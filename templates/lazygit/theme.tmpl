# {@name} theme for lazygit
#
# Preferred install — layer it over your config with a comma-separated path:
#   export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,/path/to/{@stem}.yml"
#
# Or merge the `theme:` block below into your config.yml under `gui:`.

theme:
  activeBorderColor:
    - '#{green}'    # green
    - bold
  inactiveBorderColor:
    - '#{overlay0}'    # overlay0
  searchingActiveBorderColor:
    - '#{yellow}'    # yellow
    - bold
  optionsTextColor:
    - '#{sapphire}'    # sapphire
  selectedLineBgColor:
    - '#{surface1}'    # surface1
  inactiveViewSelectedLineBgColor:
    - bold
  cherryPickedCommitFgColor:
    - '#{mauve}'    # mauve
  cherryPickedCommitBgColor:
    - '#{surface2}'    # surface2
  markedBaseCommitFgColor:
    - '#{mauve}'    # mauve
  markedBaseCommitBgColor:
    - '#{yellow}'    # yellow
  unstagedChangesColor:
    - '#{red}'    # red
  defaultFgColor:
    - '#{text}'    # text
