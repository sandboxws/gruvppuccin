# {@name} theme for lazydocker
# Merge into your config.yml under the `gui:` key:
#
#   gui:
#     theme:
#       ... (contents below)
#
# lazydocker's ThemeConfig defines exactly these four keys; any others are
# parsed and silently ignored.

theme:
  activeBorderColor:
    - '#{green}'    # green
    - bold
  inactiveBorderColor:
    - '#{overlay0}'    # overlay0
  selectedLineBgColor:
    - '#{surface1}'    # surface1
  optionsTextColor:
    - '#{sapphire}'    # sapphire
